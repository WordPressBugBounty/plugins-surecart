{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "surecart/checkout-order-bumps",
  "title": "Checkout Order Bumps",
  "description": "Recommended add-ons for the instant checkout form. Hidden when no bumps are available.",
  "keywords": [
    "order bump",
    "upsell",
    "cross-sell"
  ],
  "version": "1.0.0",
  "category": "surecart",
  "ancestor": [
    "surecart/instant-checkout-form"
  ],
  "allowedBlocks": [
    "surecart/checkout-order-bump-template"
  ],
  "attributes": {
    "label": {
      "type": "string"
    },
    "showLabel": {
      "type": "boolean",
      "default": true
    },
    "showControl": {
      "type": "boolean",
      "default": true
    },
    "hideAddedItems": {
      "type": "boolean",
      "default": false
    }
  },
  "providesContext": {
    "surecart/showControl": "showControl"
  },
  "supports": {
    "interactivity": true,
    "html": false,
    "multiple": false,
    "anchor": true,
    "color": {
      "text": true,
      "background": true,
      "gradients": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true,
      "__experimentalLetterSpacing": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true,
    "dimensions": {
      "minHeight": true
    }
  },
  "render": "file:./view.php",
  "textdomain": "surecart",
  "editorScript": "file:./index.js",
  "viewScriptModule": "@surecart/checkout-form",
  "editorStyle": [
    "file:./style-index.css",
    "surecart-theme-base",
    "surecart-choice",
    "surecart-tag",
    "surecart-label",
    "surecart-spinner"
  ],
  "style": [
    "file:./style-index.css",
    "surecart-theme-base",
    "surecart-choice",
    "surecart-tag",
    "surecart-label",
    "surecart-spinner"
  ]
}
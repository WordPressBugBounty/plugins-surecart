{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "surecart/checkout-payment-label",
  "title": "Payment Label",
  "description": "The payment section label and the test-mode badge for the instant checkout payment block.",
  "version": "1.0.0",
  "category": "surecart",
  "ancestor": [
    "surecart/checkout-payment"
  ],
  "inserter": false,
  "attributes": {
    "label": {
      "type": "string"
    },
    "showLabel": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "interactivity": true,
    "html": false,
    "anchor": true,
    "color": {
      "text": true,
      "background": true,
      "gradients": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true,
      "__experimentalLetterSpacing": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "render": "file:./view.php",
  "textdomain": "surecart",
  "editorScript": "file:./index.js",
  "viewScriptModule": "@surecart/checkout-form",
  "editorStyle": [
    "surecart-theme-base",
    "surecart-tag",
    "surecart-label"
  ],
  "style": [
    "surecart-theme-base",
    "surecart-tag",
    "surecart-label"
  ]
}
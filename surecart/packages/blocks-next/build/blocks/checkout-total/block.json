{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "surecart/checkout-total",
  "title": "Total",
  "description": "Grand total line item for the instant checkout order summary.",
  "version": "1.0.0",
  "category": "surecart",
  "ancestor": [
    "surecart/checkout-totals"
  ],
  "allowedBlocks": [
    "core/group",
    "surecart/checkout-total-label",
    "surecart/checkout-total-scratch-amount",
    "surecart/checkout-total-amount"
  ],
  "attributes": {
    "size": {
      "type": "string",
      "default": "large",
      "enum": [
        "default",
        "large"
      ]
    },
    "subscriptionText": {
      "type": "string",
      "default": ""
    },
    "dueAmountText": {
      "type": "string",
      "default": ""
    },
    "freeTrialText": {
      "type": "string",
      "default": ""
    },
    "firstPaymentTotalText": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "interactivity": true,
    "html": false,
    "multiple": true,
    "anchor": true,
    "color": {
      "text": true,
      "background": true,
      "gradients": true,
      "link": true,
      "__experimentalDefaultControls": {
        "text": true
      }
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true,
      "__experimentalLetterSpacing": true,
      "__experimentalDefaultControls": {
        "fontSize": true,
        "fontAppearance": true
      }
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true,
    "dimensions": {
      "minHeight": true
    }
  },
  "render": "file:./view.php",
  "textdomain": "surecart",
  "editorScript": "file:./index.js",
  "viewScriptModule": "@surecart/checkout-form",
  "editorStyle": [
    "file:./style-index.css",
    "surecart-theme-base",
    "surecart-line-item"
  ],
  "style": [
    "file:./style-index.css",
    "surecart-theme-base",
    "surecart-line-item"
  ]
}
{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "surecart/checkout-email",
  "title": "Email",
  "description": "Email input field for the instant checkout form.",
  "keywords": [
    "email",
    "login",
    "customer"
  ],
  "version": "1.0.0",
  "category": "surecart",
  "ancestor": [
    "surecart/instant-checkout-form"
  ],
  "attributes": {
    "label": {
      "type": "string"
    },
    "placeholder": {
      "type": "string"
    },
    "help": {
      "type": "string",
      "default": ""
    },
    "showLabel": {
      "type": "boolean",
      "default": true
    },
    "size": {
      "type": "string",
      "default": "medium",
      "enum": [
        "small",
        "medium",
        "large"
      ]
    },
    "autoFocus": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "interactivity": true,
    "html": false,
    "multiple": false,
    "anchor": true,
    "color": {
      "text": true,
      "background": true,
      "gradients": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true,
      "__experimentalLetterSpacing": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true,
    "dimensions": {
      "minHeight": true
    }
  },
  "render": "file:./view.php",
  "textdomain": "surecart",
  "editorScript": "file:./index.js",
  "viewScriptModule": [
    "@surecart/checkout-form",
    "@surecart/checkout-login"
  ],
  "editorStyle": [
    "surecart-theme-base",
    "surecart-form-group",
    "surecart-form-control",
    "surecart-label",
    "surecart-button",
    "surecart-button-reset",
    "file:./style-index.css"
  ],
  "style": [
    "surecart-theme-base",
    "surecart-form-group",
    "surecart-form-control",
    "surecart-label",
    "surecart-button",
    "surecart-button-reset",
    "file:./style-index.css"
  ]
}
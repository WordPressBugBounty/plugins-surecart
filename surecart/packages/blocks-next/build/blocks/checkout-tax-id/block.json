{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "surecart/checkout-tax-id",
  "title": "Tax ID",
  "description": "Tax ID type + number input for the instant checkout form. Hidden until a tax ID is required.",
  "version": "1.0.0",
  "category": "surecart",
  "ancestor": [
    "surecart/instant-checkout-form"
  ],
  "attributes": {
    "label": {
      "type": "string"
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "showLabel": {
      "type": "boolean",
      "default": true
    },
    "help": {
      "type": "string",
      "default": ""
    },
    "size": {
      "type": "string",
      "default": "medium",
      "enum": [
        "small",
        "medium",
        "large"
      ]
    },
    "taxIdTypes": {
      "type": "array",
      "default": [
        "eu_vat",
        "gb_vat",
        "ca_gst",
        "au_abn",
        "other"
      ],
      "items": {
        "type": "string"
      }
    }
  },
  "supports": {
    "interactivity": true,
    "html": false,
    "multiple": false,
    "anchor": true,
    "color": {
      "text": true,
      "background": true,
      "gradients": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true,
      "__experimentalLetterSpacing": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true,
    "dimensions": {
      "minHeight": true
    }
  },
  "render": "file:./view.php",
  "textdomain": "surecart",
  "editorScript": "file:./index.js",
  "viewScriptModule": "@surecart/checkout-form",
  "editorStyle": [
    "file:./style-index.css",
    "surecart-theme-base",
    "surecart-form-group",
    "surecart-form-control",
    "surecart-label"
  ],
  "style": [
    "file:./style-index.css",
    "surecart-theme-base",
    "surecart-form-group",
    "surecart-form-control",
    "surecart-label"
  ]
}
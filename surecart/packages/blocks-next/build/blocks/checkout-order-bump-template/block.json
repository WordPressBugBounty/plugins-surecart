{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "surecart/checkout-order-bump-template",
  "title": "Order Bump Card",
  "description": "The card shown for each recommended add-on.",
  "keywords": [
    "order bump",
    "upsell"
  ],
  "version": "1.0.0",
  "category": "surecart",
  "ancestor": [
    "surecart/checkout-order-bumps"
  ],
  "usesContext": [
    "surecart/showControl"
  ],
  "inserter": false,
  "supports": {
    "interactivity": true,
    "html": false,
    "reusable": false,
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "color": {
      "background": true,
      "text": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "render": "file:./view.php",
  "textdomain": "surecart",
  "editorScript": "file:./index.js",
  "viewScriptModule": "@surecart/checkout-form",
  "editorStyle": [
    "surecart-theme-base",
    "surecart-choice",
    "surecart-tag",
    "surecart-spinner"
  ],
  "style": [
    "surecart-button-reset",
    "surecart-theme-base",
    "surecart-choice",
    "surecart-tag",
    "surecart-spinner"
  ]
}
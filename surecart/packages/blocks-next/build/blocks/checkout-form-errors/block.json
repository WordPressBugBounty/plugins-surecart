{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "surecart/checkout-form-errors",
  "title": "Checkout Errors",
  "description": "Displays checkout-level error messages on the instant checkout form.",
  "keywords": [
    "error",
    "notice",
    "alert"
  ],
  "version": "1.0.0",
  "category": "surecart",
  "ancestor": [
    "surecart/instant-checkout-form"
  ],
  "supports": {
    "interactivity": true,
    "html": false,
    "multiple": false,
    "anchor": true,
    "color": {
      "text": true,
      "background": true,
      "gradients": true,
      "link": true,
      "__experimentalDefaultControls": {
        "background": true,
        "text": true
      }
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true,
      "__experimentalLetterSpacing": true,
      "__experimentalDefaultControls": {
        "fontSize": true
      }
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true,
      "__experimentalDefaultControls": {
        "radius": true
      }
    },
    "shadow": true,
    "dimensions": {
      "minHeight": true
    }
  },
  "render": "file:./view.php",
  "textdomain": "surecart",
  "editorScript": "file:./index.js",
  "viewScriptModule": "@surecart/checkout-form",
  "editorStyle": [
    "surecart-theme-base",
    "surecart-alert"
  ],
  "style": [
    "surecart-theme-base",
    "surecart-alert"
  ]
}
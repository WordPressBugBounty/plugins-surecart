{
  "$schema": "https://json.schemastore.org/block.json",
  "apiVersion": 3,
  "name": "surecart/checkout-line-item-remove",
  "title": "Remove Line Item",
  "description": "Remove button for a checkout line item.",
  "keywords": [
    "line item",
    "remove",
    "delete"
  ],
  "category": "surecart",
  "version": "1.0.0",
  "textdomain": "surecart",
  "ancestor": [
    "surecart/checkout-line-items"
  ],
  "usesContext": [
    "removable"
  ],
  "inserter": false,
  "attributes": {
    "label": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "default": "x"
    }
  },
  "supports": {
    "interactivity": true,
    "html": false,
    "reusable": false,
    "color": {
      "gradients": true,
      "text": true,
      "background": true,
      "__experimentalDefaultControls": {
        "text": true
      }
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "render": "file:./view.php",
  "editorScript": "file:./index.js",
  "editorStyle": [
    "surecart-product-line-item",
    "surecart-button-reset",
    "surecart-theme-base"
  ],
  "style": [
    "surecart-product-line-item",
    "surecart-button-reset",
    "surecart-theme-base"
  ],
  "viewScriptModule": "@surecart/checkout-form"
}
{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "surecart/checkout-billing-address",
  "title": "Billing Address",
  "description": "Billing address fields, with a 'same as shipping' toggle.",
  "version": "1.0.0",
  "category": "surecart",
  "ancestor": [
    "surecart/instant-checkout-form"
  ],
  "attributes": {
    "label": {
      "type": "string"
    },
    "toggleLabel": {
      "type": "string"
    },
    "showLabel": {
      "type": "boolean",
      "default": true
    },
    "showName": {
      "type": "boolean",
      "default": false
    },
    "requireName": {
      "type": "boolean",
      "default": false
    },
    "showLine2": {
      "type": "boolean",
      "default": false
    },
    "defaultCountry": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "interactivity": true,
    "html": false,
    "multiple": false,
    "anchor": true,
    "color": {
      "text": true,
      "background": true,
      "gradients": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true,
      "__experimentalLetterSpacing": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true,
    "dimensions": {
      "minHeight": true
    }
  },
  "render": "file:./view.php",
  "textdomain": "surecart",
  "editorScript": "file:./index.js",
  "viewScriptModule": "@surecart/checkout-form",
  "editorStyle": [
    "file:./style-index.css",
    "surecart-address",
    "surecart-theme-base",
    "surecart-form-group",
    "surecart-form-control",
    "surecart-label"
  ],
  "style": [
    "file:./style-index.css",
    "surecart-address",
    "surecart-theme-base",
    "surecart-form-group",
    "surecart-form-control",
    "surecart-label"
  ]
}
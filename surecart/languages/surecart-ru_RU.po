msgstr "Сумма не может быть больше ad_hoc_max_amount."

#: src/Abilities/Abilities/CreatePrice.php:187
msgid "Amount cannot be less than ad_hoc_min_amount."
msgstr "Сумма не может быть меньше ad_hoc_min_amount."

#: src/Abilities/Abilities/CreatePrice.php:171
msgid "ad_hoc_min_amount cannot be greater than ad_hoc_max_amount."
msgstr "ad_hoc_min_amount не может быть больше ad_hoc_max_amount."

#: src/Abilities/Abilities/CreatePrice.php:165

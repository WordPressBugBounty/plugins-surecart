#: src/Abilities/Abilities/CreatePrice.php:134
msgid "Amount is required for fixed prices."
msgstr "Для фиксированных цен требуется сумма."

#: src/Abilities/Abilities/CreatePrice.php:100
msgid "Display name for the price."
msgstr "Отображаемое название цены."

#: src/Abilities/Abilities/CreatePrice.php:96

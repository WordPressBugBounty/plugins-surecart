#: src/Abilities/Abilities/UpdateSubscriptionRenewalDate.php:206
msgid "The new renewal date must be on or after the current period end date."
msgstr "नई नवीनीकरण तारीख मौजूदा अवधि की समाप्ति तारीख के दिन या उसके बाद होनी चाहिए।"


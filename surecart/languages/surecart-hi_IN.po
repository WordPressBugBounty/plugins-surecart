#: src/Abilities/Abilities/UpdateSubscriptionRenewalDate.php:192
msgid "custom_renewal_date must be in YYYY-MM-DD format."
msgstr "custom_renewal_date YYYY-MM-DD फ़ॉर्मैट में होनी चाहिए।"

